# Copy to .env (or just paste the key in the viewer's Settings panel).
# Every person who runs Netrunners uses their OWN key. Never commit a real key.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: how your sessions are labeled in sessions/<OPERATOR>/ (defaults to your PC name)
NETRUNNERS_OPERATOR=
# Optional: port for the viewer (default 7077)
PORT=7077
